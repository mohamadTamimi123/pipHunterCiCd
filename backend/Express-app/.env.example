NODE_ENV=development
PORT=8084
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=citizix_user
POSTGRES_PASSWORD=S3cret
POSTGRES_DB=citizix_db
# In production run with DB_SYNC_ALTER=false once the schema is stable.
DB_SYNC_ALTER=true

REDIS_URL=redis://127.0.0.1:6379

API_PUBLIC_URL=http://127.0.0.1:8084
PANEL_URL=http://127.0.0.1:3002
SITE_URL=http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3002

ADMIN_EMAIL=admin@piphunter.com
ADMIN_PASSWORD=Admin@12345

GOOGLE_CLIENT_ID=

# Leave SMTP_HOST empty to print emails (OTP codes, notifications) to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=PipHunter <no-reply@piphunter.com>
ADMIN_NOTIFY_EMAIL=

# Broker: "mock" simulates accounts locally, "mt5" uses an MT5 Web API REST wrapper.
BROKER_MODE=mock
BROKER_NAME=Pivot Market
BROKER_SERVER=PivotMarket-Demo
MT5_API_URL=
MT5_API_KEY=
MT5_CHALLENGE_GROUP=demo\prop\challenge
MT5_FUNDED_GROUP=demo\prop\funded
EVALUATE_EVERY_SECONDS=30

# Payment gateways. Without credentials, checkout uses the built-in sandbox payment page.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
MANUAL_USDT_WALLET=
MANUAL_CARD_NUMBER=
DEFAULT_USD_TO_IRR=1000000
