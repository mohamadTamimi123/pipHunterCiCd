# Caddy obtains and renews HTTPS certificates automatically.
# DNS A records for {$DOMAIN}, www, panel and api must point to this server.

{$DOMAIN} {
	encode gzip
	reverse_proxy site:3000
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

panel.{$DOMAIN} {
	encode gzip
	reverse_proxy panel:3000
}

api.{$DOMAIN} {
	encode gzip
	reverse_proxy backend:8084
}
