# Copy to .env and fill in. Never commit the real .env.

# Main domain (without www). Subdomains used: panel.DOMAIN and api.DOMAIN
DOMAIN=piphunter.com

# Database (choose a strong password)
POSTGRES_USER=piphunter
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=piphunter

# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# First admin account (created on first start)
ADMIN_EMAIL=admin@piphunter.com
ADMIN_PASSWORD=CHANGE_ME

# Broker: mock (simulated accounts) until Pivot Market access is ready, then mt5
BROKER_MODE=mock
BROKER_NAME=Pivot Market
BROKER_SERVER=PivotMarket-Live
MT5_API_URL=
MT5_API_KEY=
MT5_CHALLENGE_GROUP=demo\prop\challenge
MT5_FUNDED_GROUP=real\prop\funded
EVALUATE_EVERY_SECONDS=30

# Payments. Gateways without credentials are rejected in production.
# PAYMENTS_MOCK=true enables the sandbox gateway (free orders!) - only for a private test server.
PAYMENTS_MOCK=false
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
DEFAULT_USD_TO_IRR=1000000

# Email (without SMTP, OTP codes only appear in: docker compose logs backend)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=PipHunter <no-reply@piphunter.com>
ADMIN_NOTIFY_EMAIL=

# Optional Google sign-in
GOOGLE_CLIENT_ID=
